{
  "$schema": "library.schema.json",
  "scripts": [
    {
      "cwd": ".",
      "description": "演示选项名称与脚本传值分离。只输出所选参数，不连接服务器，也不修改文件。",
      "file": "scripts/show-options.sh",
      "group": "示例/参数",
      "id": "options-demo",
      "interpreter": "/bin/bash",
      "name": "下拉参数演示",
      "parameters": [
        {
          "default": "development",
          "id": "environment",
          "label": "目标环境",
          "options": [
            {
              "label": "开发环境",
              "value": "development"
            },
            {
              "label": "预发布环境",
              "value": "staging"
            },
            {
              "label": "生产环境",
              "value": "production"
            }
          ],
          "required": true,
          "type": "select"
        },
        {
          "default": "preview",
          "id": "mode",
          "label": "运行模式",
          "options": [
            {
              "label": "preview",
              "value": "preview"
            },
            {
              "label": "verbose",
              "value": "verbose"
            }
          ],
          "required": true,
          "type": "select"
        },
        {
          "id": "note",
          "label": "备注",
          "placeholder": "可留空，试试输入含空格的内容",
          "required": false,
          "type": "text"
        }
      ]
    },
    {
      "id": "interactive-demo",
      "name": "交互终端演示",
      "group": "示例/交互",
      "description": "体验普通输入、隐藏输入、确认和进度刷新；不连接远程服务。",
      "file": "scripts/interactive-demo.sh",
      "interpreter": "/bin/bash",
      "parameters": []
    }
  ],
  "version": 1
}
