{
  "$schema": "library.schema.json",
  "scripts": [
    {
      "cwd": ".",
      "description": "Demonstrates separate option labels and values. Only prints selected arguments; does not connect to servers or change files.",
      "file": "scripts/show-options.sh",
      "group": "Examples/Parameters",
      "id": "options-demo",
      "interpreter": "/bin/bash",
      "name": "Selection Parameters Demo",
      "parameters": [
        {
          "default": "development",
          "id": "environment",
          "label": "Environment",
          "options": [
            {
              "label": "Development",
              "value": "development"
            },
            {
              "label": "Staging",
              "value": "staging"
            },
            {
              "label": "Production",
              "value": "production"
            }
          ],
          "required": true,
          "type": "select"
        },
        {
          "default": "preview",
          "id": "mode",
          "label": "Mode",
          "options": [
            {
              "label": "preview",
              "value": "preview"
            },
            {
              "label": "verbose",
              "value": "verbose"
            }
          ],
          "required": true,
          "type": "select"
        },
        {
          "id": "note",
          "label": "Note",
          "placeholder": "Optional; try a value containing spaces",
          "required": false,
          "type": "text"
        }
      ]
    },
    {
      "id": "interactive-demo",
      "name": "Interactive Terminal Demo",
      "group": "Examples/Interaction",
      "description": "Try text input, hidden input, confirmation, and progress updates without connecting to remote services.",
      "file": "scripts/interactive-demo.sh",
      "interpreter": "/bin/bash",
      "parameters": []
    }
  ],
  "version": 1
}
