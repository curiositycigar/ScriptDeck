{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script Library Configuration",
  "type": "object",
  "required": [
    "version",
    "scripts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/script"
      }
    },
    "folders": {
      "type": "array",
      "description": "Sidebar folder paths, separated by /; empty folders are supported",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "option": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "file",
            "folder",
            "select"
          ],
          "default": "text"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "default": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "passing": {
          "enum": [
            "positional",
            "named",
            "flag"
          ],
          "default": "positional"
        },
        "argumentName": {
          "type": "string",
          "pattern": "^-{1,2}[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "argumentFormat": {
          "enum": [
            "separated",
            "equals"
          ],
          "default": "separated"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "passing": {
                "enum": [
                  "named",
                  "flag"
                ]
              }
            },
            "required": [
              "passing"
            ]
          },
          "then": {
            "required": [
              "argumentName"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "passing": {
                "const": "flag"
              }
            },
            "required": [
              "passing"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "enum": [
                  "",
                  "true",
                  "false"
                ]
              }
            }
          }
        }
      ]
    },
    "script": {
      "type": "object",
      "required": [
        "id",
        "name",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to the library folder, or an absolute path"
        },
        "group": {
          "type": "string",
          "description": "Separate nested groups with /. Omit to use the localized Ungrouped group."
        },
        "description": {
          "type": "string"
        },
        "interpreter": {
          "type": "string",
          "minLength": 1,
          "default": "/bin/bash",
          "description": "/bin/bash, /bin/zsh, python3, node, direct, or an absolute interpreter path"
        },
        "cwd": {
          "type": "string",
          "description": "Relative to the library folder; defaults to the script folder when omitted"
        },
        "execution": {
          "enum": [
            "embedded",
            "terminal"
          ],
          "deprecated": true,
          "description": "Deprecated compatibility field. All manual scripts use the embedded interactive terminal; this field no longer affects execution."
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        }
      }
    }
  }
}
